# Mẫu biến môi trường. Sao chép thành .env rồi điền giá trị thật:
#   Copy-Item .env.example .env
#
# LƯU Ý: .env đã được .gitignore bỏ qua — không commit khoá thật.

# --- LLM (bắt buộc) ---
GEMINI_API_KEY=

# --- Sinh ảnh (bắt buộc nếu không dùng --no-images) ---
POLLINATIONS_API_KEY=

# --- Đăng bài lên Facebook Page (chỉ cần khi Config/publish.json -> mode = "publish") ---
# Tên biến phải khớp Config/publish.json:
#   facebook.page_id_env       (mặc định "PAGE_ID")
#   facebook.access_token_env  (mặc định "PAGE_ACCESS_TOKEN")
# Cách lấy:
#   1. Tạo Meta app (developers.facebook.com) và một Facebook Page.
#   2. Cấp quyền pages_show_list, pages_read_engagement, pages_manage_posts.
#   3. Điền PAGE_ID và PAGE_ACCESS_TOKEN (user token cũng được — service tự
#      đổi sang Page access token khi Facebook yêu cầu).
PAGE_ID=
PAGE_ACCESS_TOKEN=

# --- Đăng bài lên YouTube (chỉ cần khi bật "youtube" trong Config/publish.json) ---
# Tên biến phải khớp Config/publish.json:
#   youtube.client_id_env      (mặc định "YT_CLIENT_ID")
#   youtube.client_secret_env  (mặc định "YT_CLIENT_SECRET")
#   youtube.refresh_token_env  (mặc định "YT_REFRESH_TOKEN")
# Cách lấy:
#   1. Tạo project Google Cloud, bật "YouTube Data API v3".
#   2. Tạo OAuth client (Desktop app), tải JSON về yt-secret/client_secret.json.
#   3. Chạy: python youtube_auth.py  (mở trình duyệt và tự điền 3 biến dưới).
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# --- Tuỳ chọn: chỉ định đường dẫn công cụ nếu không có trong PATH ---
# FFMPEG_PATH=
# FFPROBE_PATH=
# WHITEBOARD_CLI=
