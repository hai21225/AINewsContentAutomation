{
    "platform": "facebook",

    "mode": "prepare",

    "output_dir": "output/publish",

    "facebook": {
        "api_version": "v26.0",
        "graph_url": "https://graph.facebook.com",
        "graph_video_url": "https://graph-video.facebook.com",
        "page_id_env": "FB_PAGE_ID",
        "access_token_env": "FB_PAGE_ACCESS_TOKEN",
        "published": true,
        "check_existing": true,
        "max_file_bytes": 1073741824,
        "timeout_seconds": 600
    }
}
